{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "labmilvet",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "labmilvet@gmail.com",
      "allowed_sender_addresses": ["cadastro@labmilvet.com.br"]
    }
  ],
  "ratelimits": [
    {
      "name": "REGISTRATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "labmilvet.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.labmilvet.com.br",
      "custom_domain": true
    }
  ]
}
